NavigasiManager:
    WelcomeScreen:
    LoginScreen:
    DashboardScreen:
    ProductsScreen:
    OrdersScreen:
    FinancialReportScreen:
    ProfileScreen:


<WelcomeScreen>:
    name: "welcome"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 18

        canvas.before:
            Color:
                rgba: 0.93, 0.97, 0.94, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:

        Label:
            text: "EARTHGLOW SOAP"
            font_size: "28sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1

        Label:
            text: "Admin Panel"
            font_size: "20sp"
            color: 0.25, 0.45, 0.35, 1

        Label:
            text: "Kelola produk, pesanan, dan laporan dengan mudah"
            font_size: "15sp"
            color: 0.35, 0.35, 0.35, 1
            halign: "center"
            text_size: self.size

        Widget:

        Button:
            text: "MASUK SEBAGAI ADMIN"
            size_hint_y: None
            height: 58
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            border: (0,0,0,0)
            on_release: root.manager.current = "login"

        Widget:


<LoginScreen>:
    name: "login"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 14

        canvas.before:
            Color:
                rgba: 0.95, 0.98, 0.96, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LOGIN ADMIN"
            font_size: "24sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 50

        TextInput:
            id: email_input
            hint_text: "Email admin"
            multiline: False
            size_hint_y: None
            height: 48

        TextInput:
            id: password_input
            hint_text: "Password"
            password: True
            multiline: False
            size_hint_y: None
            height: 48

        Label:
            text: root.pesan
            color: 0.8, 0.1, 0.1, 1
            size_hint_y: None
            height: 30

        Button:
            text: "LOGIN"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            on_release: root.login()

        Button:
            text: "Kembali"
            size_hint_y: None
            height: 46
            on_release: root.manager.current = "welcome"

        Widget:


<DashboardScreen>:
    name: "dashboard"

    BoxLayout:
        orientation: "vertical"
        padding: 18
        spacing: 12

        canvas.before:
            Color:
                rgba: 0.94, 0.98, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "DASHBOARD EARTHGLOW"
            font_size: "22sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 50

        GridLayout:
            cols: 2
            spacing: 10
            size_hint_y: None
            height: 160

            Label:
                text: "TOTAL PRODUK\n" + root.total_products
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.1, 0.3, 0.2, 1
                canvas.before:
                    Color:
                        rgba: 0.93, 0.99, 0.95, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            Label:
                text: "TOTAL STOK\n" + root.total_stock
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.1, 0.3, 0.2, 1
                canvas.before:
                    Color:
                        rgba: 0.92, 0.98, 0.94, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            Label:
                text: "TOTAL PESANAN\n" + root.total_orders
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.1, 0.3, 0.2, 1
                canvas.before:
                    Color:
                        rgba: 0.90, 0.96, 0.91, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            Label:
                text: "STATUS\nONLINE"
                halign: "center"
                valign: "middle"
                text_size: self.size
                color: 0.1, 0.3, 0.2, 1
                canvas.before:
                    Color:
                        rgba: 0.88, 0.94, 0.90, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

        Widget:

        Button:
            text: "KELOLA PRODUK"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.25, 0.55, 0.4, 1
            on_release: root.manager.current = "products"

        Button:
            text: "LIHAT PESANAN"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.31, 0.62, 0.46, 1
            on_release: root.manager.current = "orders"

        Button:
            text: "LAPORAN KEUANGAN"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.39, 0.69, 0.54, 1
            on_release: root.manager.current = "financial_report"

        Button:
            text: "PROFIL"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.48, 0.77, 0.64, 1
            on_release: root.manager.current = "profile"

        Button:
            text: "LOGOUT"
            size_hint_y: None
            height: 50
            background_normal: ""
            background_color: 0.38, 0.39, 0.40, 1
            on_release: root.manager.current = "welcome"

        Widget:


<ProductsScreen>:
    name: "products"

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 10

        Label:
            text: "DAFTAR PRODUK"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 60

        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: product_list
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "TAMBAH BARANG"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.open_product_form()

            Button:
                text: "KEMBALI KE DASHBOARD"
                on_release: root.manager.current = "dashboard"


<OrdersScreen>:
    name: "orders"

    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 20

        canvas.before:
            Color:
                rgba: 0.96, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "DATA PESANAN"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 60

        ScrollView:
            do_scroll_x: True
            do_scroll_y: True

            GridLayout:
                id: orders_table
                cols: 8
                spacing: 3
                padding: 3
                size_hint: (None, None)
                width: 1400
                height: 200

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "LAPORAN KEUANGAN"
                on_release: root.manager.current = "financial_report"

            Button:
                text: "KEMBALI KE DASHBOARD"
                on_release: root.manager.current = "dashboard"


<FinancialReportScreen>:
    name: "financial_report"

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 12

        canvas.before:
            Color:
                rgba: 0.95, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LAPORAN KEUANGAN"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 60

        Label:
            id: report_summary
            text: "Memuat laporan..."
            halign: "left"
            valign: "top"
            text_size: self.size
            font_size: "16sp"
            color: 0.15, 0.25, 0.20, 1
            size_hint_y: None
            height: 120

        ScrollView:
            do_scroll_x: True
            do_scroll_y: True

            GridLayout:
                id: report_table
                cols: 8
                spacing: 3
                padding: 3
                size_hint: (None, None)
                width: 1400
                height: 200

        Label:
            id: report_message
            text: ""
            color: 0.12, 0.55, 0.30, 1
            size_hint_y: None
            height: 22

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "CETAK LAPORAN"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.print_report()

            Button:
                text: "KEMBALI"
                on_release: root.manager.current = "dashboard"


<ProfileScreen>:
    name: "profile"

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: "vertical"
            padding: 30
            spacing: 12
            size_hint_y: None
            height: self.minimum_height

            canvas.before:
                Color:
                    rgba: 0.94, 0.98, 0.97, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Edit Profile"
                font_size: "28sp"
                bold: True
                color: 0.10, 0.28, 0.20, 1
                size_hint_y: None
                height: 55

            Label:
                text: "Kelola informasi akun kamu"
                font_size: "14sp"
                color: 0.35, 0.42, 0.38, 1
                size_hint_y: None
                height: 30

            Widget:
                size_hint_y: None
                height: 5

            Image:
                id: foto_profil
                source: ""
                size_hint: None, None
                size: 125, 125
                pos_hint: {"center_x": 0.5}

            Button:
                text: "Ubah Foto Profil"
                size_hint: None, None
                size: 150, 38
                pos_hint: {"center_x": 0.5}
                background_normal: ""
                background_color: 0.78, 0.89, 0.83, 1
                color: 0.10, 0.30, 0.20, 1
                font_size: "13sp"
                on_release: root.pilih_foto()

            Widget:
                size_hint_y: None
                height: 12

            Label:
                text: "Nama Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_admin
                    text: "EarthGlow Admin"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Email Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: email_admin
                    text: "admin@earthglow.com"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Nama Toko"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_toko
                    text: "EarthGlow Soap"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Widget:
                size_hint_y: None
                height: 8

            Label:
                id: profile_message
                text: ""
                color: 0.10, 0.45, 0.25, 1
                font_size: "13sp"
                size_hint_y: None
                height: 30

            Button:
                text: "Simpan Perubahan"
                size_hint_y: None
                height: 50
                background_normal: ""
                background_color: 0.25, 0.55, 0.40, 1
                font_size: "15sp"
                on_release: root.save_profile()

            Button:
                text: "Kembali"
                size_hint_y: None
                height: 45
                background_normal: ""
                background_color: 0.35, 0.35, 0.35, 1
                on_release: root.manager.current = "dashboard"

            Widget:
                size_hint_y: None
                height: 20