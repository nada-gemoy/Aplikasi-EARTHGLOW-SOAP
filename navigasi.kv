NavigasiManager:
    WelcomeScreen:
    LoginScreen:
    DashboardScreen:
    ProductsScreen:
    DirectTransactionsScreen:
    OrdersScreen:
    ReturnsScreen:
    FinancialReportScreen:
    ProfileScreen:
    CashierScreen:


<WelcomeScreen>:
    name: "welcome"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 18

        canvas.before:
            Color:
                rgba: 0.93, 0.97, 0.94, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:

        Label:
            text: "EARTHGLOW SOAP"
            font_size: "28sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1

        Label:
            text: "Admin Panel"
            font_size: "20sp"
            color: 0.25, 0.45, 0.35, 1

        Label:
            text: "Kelola produk, pesanan, dan laporan dengan mudah"
            font_size: "15sp"
            color: 0.35, 0.35, 0.35, 1
            halign: "center"
            text_size: self.size

        Widget:

        Button:
            text: "MASUK SEBAGAI ADMIN"
            size_hint_y: None
            height: 58
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            border: (0,0,0,0)
            on_release: root.manager.current = "login"

        Widget:


<LoginScreen>:
    name: "login"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 14

        canvas.before:
            Color:
                rgba: 0.95, 0.98, 0.96, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LOGIN ADMIN"
            font_size: "24sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 50

        TextInput:
            id: email_input
            hint_text: "Email admin"
            multiline: False
            size_hint_y: None
            height: 48

        TextInput:
            id: password_input
            hint_text: "Password"
            password: True
            multiline: False
            size_hint_y: None
            height: 48

        Label:
            text: root.pesan
            color: 0.8, 0.1, 0.1, 1
            size_hint_y: None
            height: 30

        Button:
            text: "LOGIN"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            on_release: root.login()

        Button:
            text: "Kembali"
            size_hint_y: None
            height: 46
            on_release: root.manager.current = "welcome"

        Widget:


<DashboardScreen>:
    name: "dashboard"

    ScrollView:
        do_scroll_x: False
        bar_width: dp(4)

        BoxLayout:
            orientation: "vertical"
            padding: dp(14)
            spacing: dp(10)
            size_hint_y: None
            height: self.minimum_height

            canvas.before:
                Color:
                    rgba: 0.94, 0.98, 0.95, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "DASHBOARD EARTHGLOW"
                font_size: "22sp"
                bold: True
                color: 0.12, 0.35, 0.25, 1
                size_hint_y: None
                height: dp(48)

            GridLayout:
                cols: 2
                spacing: dp(8)
                size_hint_y: None
                height: dp(144)

                Label:
                    text: "TOTAL PRODUK\n" + root.total_products
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: 0.1, 0.3, 0.2, 1
                    canvas.before:
                        Color:
                            rgba: 0.93, 0.99, 0.95, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                Label:
                    text: "TOTAL STOK\n" + root.total_stock
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: 0.1, 0.3, 0.2, 1
                    canvas.before:
                        Color:
                            rgba: 0.92, 0.98, 0.94, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                Label:
                    text: "PESANAN ONLINE\n" + root.total_orders
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: 0.1, 0.3, 0.2, 1
                    canvas.before:
                        Color:
                            rgba: 0.90, 0.96, 0.91, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                Label:
                    text: "TRANSAKSI LANGSUNG\n" + root.total_direct
                    halign: "center"
                    valign: "middle"
                    text_size: self.size
                    color: 0.1, 0.3, 0.2, 1
                    canvas.before:
                        Color:
                            rgba: 0.88, 0.94, 0.90, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

            Button:
                text: "PEMBELIAN / TRANSAKSI LANGSUNG"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.18, 0.52, 0.38, 1
                on_release: root.manager.current = "cashier"

            Button:
                text: "PESANAN ONLINE" if root.new_online_orders == "0" else "PESANAN ONLINE • " + root.new_online_orders + " BARU"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.manager.current = "orders"

            Button:
                text: "RETUR BARANG"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.55, 0.38, 0.24, 1
                on_release: root.manager.current = "returns"

            Button:
                text: "KELOLA PRODUK"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.31, 0.62, 0.46, 1
                on_release: root.manager.current = "products"

            Button:
                text: "LAPORAN KEUANGAN"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.39, 0.69, 0.54, 1
                on_release: root.manager.current = "financial_report"

            Button:
                text: "PROFIL"
                size_hint_y: None
                height: dp(50)
                font_size: "14sp"
                background_normal: ""
                background_color: 0.48, 0.77, 0.64, 1
                on_release: root.manager.current = "profile"


<CashierScreen>:
    name: "cashier"

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        canvas.before:
            Color:
                rgba: 0.95, 0.99, 0.96, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "KASIR • PEMBELIAN LANGSUNG"
            font_size: "21sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(42)

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)

            Spinner:
                id: product_spinner
                text: "Pilih produk"
                values: []

            Button:
                id: add_product_button
                text: "TAMBAH"
                size_hint_x: None
                width: dp(92)
                background_normal: ""
                background_color: 0.18, 0.52, 0.38, 1
                on_release: root.add_selected_product()

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)

            GridLayout:
                id: cart_list
                cols: 1
                spacing: dp(5)
                size_hint_y: None
                height: self.minimum_height

        Label:
            text: "TOTAL: " + root.total_text
            font_size: "22sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(42)

        TextInput:
            id: customer_input
            hint_text: "Nama pelanggan (opsional)"
            multiline: False
            size_hint_y: None
            height: dp(42)

        Spinner:
            id: payment_spinner
            text: "Cash"
            values: ["Cash", "QRIS"]
            size_hint_y: None
            height: dp(42)

        BoxLayout:
            id: cash_received_row
            size_hint_y: None
            height: dp(42)

            TextInput:
                id: cash_received
                hint_text: "Uang diterima"
                multiline: False
                input_filter: "int"
                on_text: root.update_change()

        Label:
            text: root.change_text
            size_hint_y: None
            height: dp(30)
            color: 0.12, 0.35, 0.25, 1

        Label:
            id: cashier_message
            text: ""
            size_hint_y: None
            height: dp(36)
            color: 0.55, 0.18, 0.12, 1

        Button:
            text: root.payment_button_text
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            on_release: root.request_payment()

        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)

            Button:
                text: "RIWAYAT TRANSAKSI"
                on_release: root.manager.current = "direct_sales"

            Button:
                text: "DASHBOARD"
                on_release: root.manager.current = "dashboard"


<ProductsScreen>:
    name: "products"

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        canvas.before:
            Color:
                rgba: 0.96, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "DAFTAR PRODUK"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(48)

        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: product_list
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            Button:
                text: "TAMBAH BARANG"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.open_product_form()

            Button:
                text: "KEMBALI KE DASHBOARD"
                on_release: root.manager.current = "dashboard"


<OrdersScreen>:
    name: "orders"

<DirectTransactionsScreen>:
    name: "direct_sales"

<ReturnsScreen>:
    name: "returns"

<ChannelTransactionsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(10)
        spacing: dp(6)

        canvas.before:
            Color:
                rgba: 0.96, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: root.screen_title
            font_size: "23sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(40)

        Label:
            id: channel_summary
            text: "Ringkasan pembukuan..."
            font_size: "12sp"
            halign: "left"
            valign: "middle"
            text_size: self.size
            color: 0.12, 0.25, 0.18, 1
            size_hint_y: None
            height: dp(82)

        Label:
            id: channel_message
            text: ""
            font_size: "11sp"
            halign: "left"
            valign: "middle"
            text_size: self.size
            color: 0.12, 0.45, 0.25, 1
            size_hint_y: None
            height: dp(38)

        ScrollView:
            id: orders_scroll
            do_scroll_x: False
            do_scroll_y: True
            size_hint_y: 0.42 if root.manages_returns else 1
            bar_width: dp(4)

            GridLayout:
                id: orders_table
                cols: 1
                spacing: dp(6)
                padding: 0
                size_hint: (1, None)
                width: orders_scroll.width
                height: self.minimum_height

        Label:
            text: "RIWAYAT RETUR"
            opacity: 1 if root.manages_returns else 0
            font_size: "17sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(28) if root.manages_returns else 0

        ScrollView:
            id: return_scroll
            do_scroll_x: False
            do_scroll_y: True
            size_hint_y: 0.32 if root.manages_returns else 0
            height: dp(0)
            opacity: 1 if root.manages_returns else 0
            bar_width: dp(4)

            GridLayout:
                id: return_history
                cols: 1
                spacing: dp(6)
                padding: 0
                size_hint: (1, None)
                width: return_scroll.width
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            orientation: "vertical"
            height: dp(96) if not root.manages_returns else dp(54)
            spacing: dp(5)

            Button:
                text: "CATAT PESANAN ONLINE" if root.channel == "online" else "BUKA KASIR POS"
                opacity: 0 if root.manages_returns else 1
                disabled: root.manages_returns
                size_hint_y: None
                height: dp(42) if not root.manages_returns else 0
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                font_size: "13sp"
                on_release: root.create_order_form() if root.channel == "online" else root.open_pos()

            BoxLayout:
                size_hint_y: None
                height: dp(44) if not root.manages_returns else 0
                spacing: dp(6)
                opacity: 1 if not root.manages_returns else 0
                disabled: root.manages_returns

                Button:
                    text: "RETUR BARANG"
                    background_normal: ""
                    background_color: 0.55, 0.38, 0.24, 1
                    font_size: "12sp"
                    on_release: root.manager.current = "returns"

                Button:
                    text: "DASHBOARD"
                    font_size: "12sp"
                    on_release: root.manager.current = "dashboard"

            BoxLayout:
                size_hint_y: None
                height: dp(44) if root.manages_returns else 0
                spacing: dp(6)
                opacity: 1 if root.manages_returns else 0
                disabled: not root.manages_returns

                Button:
                    text: "PESANAN ONLINE"
                    font_size: "12sp"
                    on_release: root.manager.current = "orders"

                Button:
                    text: "DASHBOARD"
                    font_size: "12sp"
                    on_release: root.manager.current = "dashboard"


<FinancialReportScreen>:
    name: "financial_report"

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        canvas.before:
            Color:
                rgba: 0.95, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LAPORAN KEUANGAN"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: dp(48)

        Label:
            id: report_summary
            text: "Memuat laporan..."
            halign: "left"
            valign: "top"
            text_size: self.size
            font_size: "12sp"
            color: 0.15, 0.25, 0.20, 1
            size_hint_y: None
            height: dp(116)

        ScrollView:
            id: report_scroll
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)

            GridLayout:
                id: report_table
                cols: 1
                spacing: dp(6)
                padding: 0
                size_hint: (1, None)
                width: report_scroll.width
                height: self.minimum_height

        Label:
            id: report_message
            text: ""
            font_size: "11sp"
            color: 0.12, 0.55, 0.30, 1
            size_hint_y: None
            height: dp(32)
            text_size: self.size
            halign: "left"
            valign: "middle"

        BoxLayout:
            size_hint_y: None
            orientation: "vertical"
            height: dp(92)
            spacing: dp(5)

            Button:
                text: "EKSPOR EXCEL"
                size_hint_y: None
                height: dp(42)
                background_normal: ""
                background_color: 0.18, 0.52, 0.38, 1
                font_size: "13sp"
                on_release: root.export_excel()

            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(6)

                Button:
                    text: "CETAK"
                    font_size: "12sp"
                    on_release: root.print_report()

                Button:
                    text: "DASHBOARD"
                    font_size: "12sp"
                    on_release: root.manager.current = "dashboard"


<ProfileScreen>:
    name: "profile"

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: "vertical"
            padding: 30
            spacing: 12
            size_hint_y: None
            height: self.minimum_height

            canvas.before:
                Color:
                    rgba: 0.94, 0.98, 0.97, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Edit Profile"
                font_size: "28sp"
                bold: True
                color: 0.10, 0.28, 0.20, 1
                size_hint_y: None
                height: 55

            Label:
                text: "Kelola informasi akun kamu"
                font_size: "14sp"
                color: 0.35, 0.42, 0.38, 1
                size_hint_y: None
                height: 30

            Label:
                text: "Akun aktif: " + (root.manager.current_user['name'] if root.manager.current_user else "EarthGlow Admin")
                color: 0.12, 0.35, 0.25, 1
                bold: True
                font_size: "14sp"
                size_hint_y: None
                height: 28

            Widget:
                size_hint_y: None
                height: 5

            Image:
                id: foto_profil
                source: ""
                size_hint: None, None
                size: 125, 125
                pos_hint: {"center_x": 0.5}

            Button:
                text: "Ubah Foto Profil"
                size_hint: None, None
                size: 150, 38
                pos_hint: {"center_x": 0.5}
                background_normal: ""
                background_color: 0.78, 0.89, 0.83, 1
                color: 0.10, 0.30, 0.20, 1
                font_size: "13sp"
                on_release: root.pilih_foto()

            Widget:
                size_hint_y: None
                height: 12

            Label:
                text: "Nama Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_admin
                    text: "EarthGlow Admin"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Email Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: email_admin
                    text: "admin@earthglow.com"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Nama Toko"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_toko
                    text: "EarthGlow Soap"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Widget:
                size_hint_y: None
                height: 8

            Label:
                id: profile_message
                text: ""
                color: 0.10, 0.45, 0.25, 1
                font_size: "13sp"
                size_hint_y: None
                height: 30

            Button:
                text: "Simpan Perubahan"
                size_hint_y: None
                height: 50
                background_normal: ""
                background_color: 0.25, 0.55, 0.40, 1
                font_size: "15sp"
                on_release: root.save_profile()

            Button:
                text: "Logout"
                size_hint_y: None
                height: 45
                background_normal: ""
                background_color: 0.38, 0.39, 0.40, 1
                on_release: root.logout()

            Button:
                text: "Kembali"
                size_hint_y: None
                height: 45
                background_normal: ""
                background_color: 0.35, 0.35, 0.35, 1
                on_release: root.manager.current = "dashboard"

            Widget:
                size_hint_y: None
                height: 20