NavigasiManager:
    WelcomeScreen:
    LoginScreen:
    DashboardScreen:
    CashierScreen:
    ProductsScreen:
    OrdersScreen:
    FinancialReportScreen:
    ProfileScreen:


<WelcomeScreen>:
    name: "welcome"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 18

        canvas.before:
            Color:
                rgba: 0.93, 0.97, 0.94, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:

        Label:
            text: "EARTHGLOW SOAP"
            font_size: "28sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1

        Label:
            text: "Admin Panel"
            font_size: "20sp"
            color: 0.25, 0.45, 0.35, 1

        Label:
            text: "Kelola produk, pesanan, dan laporan dengan mudah"
            font_size: "15sp"
            color: 0.35, 0.35, 0.35, 1
            halign: "center"
            text_size: self.size

        Widget:

        Button:
            text: "MASUK SEBAGAI ADMIN"
            size_hint_y: None
            height: 58
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            border: (0,0,0,0)
            on_release: root.manager.current = "login"

        Widget:


<LoginScreen>:
    name: "login"

    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 14

        canvas.before:
            Color:
                rgba: 0.95, 0.98, 0.96, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LOGIN ADMIN"
            font_size: "24sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 50

        TextInput:
            id: email_input
            hint_text: "Email admin"
            multiline: False
            size_hint_y: None
            height: 48

        TextInput:
            id: password_input
            hint_text: "Password"
            password: True
            multiline: False
            size_hint_y: None
            height: 48

        Label:
            text: root.pesan
            color: 0.8, 0.1, 0.1, 1
            size_hint_y: None
            height: 30

        Button:
            text: "LOGIN"
            size_hint_y: None
            height: 54
            background_normal: ""
            background_color: 0.18, 0.52, 0.38, 1
            on_release: root.login()

        Button:
            text: "Kembali"
            size_hint_y: None
            height: 46
            on_release: root.manager.current = "welcome"

        Widget:


<DashboardScreen>:
    name: "dashboard"

    BoxLayout:
        orientation: "vertical"
        padding: 14
        spacing: 8

        canvas.before:
            Color:
                rgba: 0.94, 0.98, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "EARTHGLOW SOAP"
            font_size: "21sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 38

        Label:
            text: root.total_products + " produk  |  stok " + root.total_stock + "  |  " + root.total_orders + " transaksi"
            color: 0.34, 0.43, 0.37, 1
            size_hint_y: None
            height: 24

        Label:
            text: root.catalog_message
            color: 0.14, 0.43, 0.31, 1
            size_hint_y: None
            height: 22

        Label:
            text: "PILIH PRODUK"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 28

        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: catalog_grid
                cols: 2
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        GridLayout:
            cols: 2
            spacing: 6
            size_hint_y: None
            height: 78

            Button:
                text: "KELOLA PRODUK"
                on_release: root.manager.current = "products"

            Button:
                text: "PESANAN"
                on_release: root.manager.current = "orders"

            Button:
                text: "LAPORAN"
                on_release: root.manager.current = "financial_report"

            Button:
                text: "LOGOUT"
                on_release: root.manager.current = "welcome"

        Button:
            text: "BUKA KASIR  (" + root.cart_count + ")"
            size_hint_y: None
            height: "50dp"
            background_normal: ""
            background_color: 0.14, 0.43, 0.31, 1
            on_release: root.open_cashier()


<CashierScreen>:
    name: "cashier"

    BoxLayout:
        orientation: "vertical"
        padding: "12dp"
        spacing: "5dp"

        canvas.before:
            Color:
                rgba: 0.95, 0.98, 0.95, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "KASIR"
            bold: True
            font_size: "20sp"
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: "34dp"
            halign: "left"
            text_size: self.size

        TextInput:
            id: customer_input
            hint_text: "Nama pelanggan (opsional)"
            multiline: False
            size_hint_y: None
            height: "42dp"

        Label:
            text: "DAFTAR BELANJA"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: "24dp"
            halign: "left"
            text_size: self.size

        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: cart_list
                cols: 1
                spacing: "5dp"
                size_hint_y: None
                height: self.minimum_height

        Label:
            text: "TOTAL TAGIHAN  " + root.total_text
            bold: True
            font_size: "18sp"
            color: 0.10, 0.32, 0.22, 1
            size_hint_y: None
            height: "36dp"
            halign: "right"
            text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: "44dp"
            spacing: "5dp"

            Button:
                text: "Cash"
                background_normal: ""
                background_color: (0.18, 0.52, 0.38, 1) if root.payment_method == "Cash" else (0.84, 0.9, 0.85, 1)
                color: (1, 1, 1, 1) if root.payment_method == "Cash" else (0.12, 0.25, 0.18, 1)
                on_release: root.select_payment("Cash")

            Button:
                text: "QRIS"
                background_normal: ""
                background_color: (0.18, 0.52, 0.38, 1) if root.payment_method == "QRIS" else (0.84, 0.9, 0.85, 1)
                color: (1, 1, 1, 1) if root.payment_method == "QRIS" else (0.12, 0.25, 0.18, 1)
                on_release: root.select_payment("QRIS")

            Button:
                text: "Debit"
                background_normal: ""
                background_color: (0.18, 0.52, 0.38, 1) if root.payment_method == "Debit" else (0.84, 0.9, 0.85, 1)
                color: (1, 1, 1, 1) if root.payment_method == "Debit" else (0.12, 0.25, 0.18, 1)
                on_release: root.select_payment("Debit")

        Spinner:
            id: status_spinner
            text: "Lunas"
            values: ["Lunas", "Belum Lunas"]
            size_hint_y: None
            height: "38dp"

        BoxLayout:
            id: payment_destination_row
            orientation: "vertical"
            size_hint_y: None
            height: 0
            opacity: 0

            Label:
                text: root.payment_destination_label
                color: 0.12, 0.35, 0.25, 1
                size_hint_y: None
                height: "22dp"
                halign: "left"
                text_size: self.size

            TextInput:
                id: payment_destination
                hint_text: root.payment_destination_hint
                multiline: False
                size_hint_y: None
                height: "42dp"

        BoxLayout:
            id: cash_received_row
            orientation: "vertical"
            size_hint_y: None
            height: "42dp"

            TextInput:
                id: cash_received
                hint_text: "Uang diterima (Rp)"
                multiline: False
                input_filter: "int"
                size_hint_y: None
                height: "42dp"
                on_text: root.update_change()

        Label:
            text: root.change_text
            color: 0.18, 0.40, 0.28, 1
            size_hint_y: None
            height: "24dp"
            halign: "right"
            text_size: self.size

        Label:
            id: cashier_message
            text: ""
            color: 0.72, 0.15, 0.12, 1
            size_hint_y: None
            height: "22dp"

        BoxLayout:
            size_hint_y: None
            height: "52dp"
            spacing: "7dp"

            Button:
                text: "KEMBALI"
                size_hint_x: 0.34
                on_release: root.back_to_catalog()

            Button:
                text: "SELESAIKAN TRANSAKSI"
                size_hint_x: 0.66
                background_normal: ""
                background_color: 0.14, 0.43, 0.31, 1
                on_release: root.complete_sale()


<ProductsScreen>:
    name: "products"

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 10

        Label:
            text: "DAFTAR PRODUK"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 60

        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: product_list
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "TAMBAH BARANG"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.open_product_form()

            Button:
                text: "KEMBALI KE DASHBOARD"
                on_release: root.manager.current = "dashboard"


<OrdersScreen>:
    name: "orders"

    BoxLayout:
        orientation: "vertical"
        padding: 25
        spacing: 20

        canvas.before:
            Color:
                rgba: 0.96, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "DATA PESANAN"
            font_size: "25sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: 60

        ScrollView:
            do_scroll_x: True
            do_scroll_y: True

            GridLayout:
                id: orders_table
                cols: 8
                spacing: 3
                padding: 3
                size_hint: (None, None)
                width: 1400
                height: 200

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "LAPORAN KEUANGAN"
                on_release: root.manager.current = "financial_report"

            Button:
                text: "KEMBALI KE DASHBOARD"
                on_release: root.manager.current = "dashboard"


<FinancialReportScreen>:
    name: "financial_report"

    BoxLayout:
        orientation: "vertical"
        padding: "14dp"
        spacing: "8dp"

        canvas.before:
            Color:
                rgba: 0.95, 0.99, 0.97, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "LAPORAN KEUANGAN"
            font_size: "21sp"
            bold: True
            color: 0.12, 0.35, 0.25, 1
            size_hint_y: None
            height: "52dp"

        Label:
            id: report_summary
            text: "Memuat laporan..."
            halign: "left"
            valign: "top"
            text_size: self.size
            font_size: "15sp"
            color: 0.15, 0.25, 0.20, 1
            size_hint_y: None
            height: "86dp"

        ScrollView:
            do_scroll_x: True
            do_scroll_y: True

            GridLayout:
                id: report_table
                cols: 8
                spacing: 3
                padding: 3
                size_hint: (None, None)
                width: 1400
                height: 200

        Label:
            id: report_message
            text: ""
            color: 0.12, 0.55, 0.30, 1
            size_hint_y: None
            height: "22dp"

        BoxLayout:
            size_hint_y: None
            height: "50dp"
            spacing: "8dp"

            Button:
                text: "CETAK LAPORAN"
                background_normal: ""
                background_color: 0.25, 0.55, 0.4, 1
                on_release: root.print_report()

            Button:
                text: "KEMBALI"
                on_release: root.manager.current = "dashboard"


<ProfileScreen>:
    name: "profile"

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            orientation: "vertical"
            padding: 30
            spacing: 12
            size_hint_y: None
            height: self.minimum_height

            canvas.before:
                Color:
                    rgba: 0.94, 0.98, 0.97, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Edit Profile"
                font_size: "28sp"
                bold: True
                color: 0.10, 0.28, 0.20, 1
                size_hint_y: None
                height: 55

            Label:
                text: "Kelola informasi akun kamu"
                font_size: "14sp"
                color: 0.35, 0.42, 0.38, 1
                size_hint_y: None
                height: 30

            Widget:
                size_hint_y: None
                height: 5

            Image:
                id: foto_profil
                source: ""
                size_hint: None, None
                size: 125, 125
                pos_hint: {"center_x": 0.5}

            Button:
                text: "Ubah Foto Profil"
                size_hint: None, None
                size: 150, 38
                pos_hint: {"center_x": 0.5}
                background_normal: ""
                background_color: 0.78, 0.89, 0.83, 1
                color: 0.10, 0.30, 0.20, 1
                font_size: "13sp"
                on_release: root.pilih_foto()

            Widget:
                size_hint_y: None
                height: 12

            Label:
                text: "Nama Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_admin
                    text: "EarthGlow Admin"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Email Admin"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: email_admin
                    text: "admin@earthglow.com"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Label:
                text: "Nama Toko"
                color: 0.35, 0.42, 0.38, 1
                font_size: "13sp"
                halign: "left"
                text_size: self.size
                size_hint_y: None
                height: 25

            BoxLayout:
                spacing: 8
                size_hint_y: None
                height: 48

                TextInput:
                    id: nama_toko
                    text: "EarthGlow Soap"
                    multiline: False
                    background_color: 1, 1, 1, 1
                    foreground_color: 0.1, 0.1, 0.1, 1
                    padding: 15, 12

                Button:
                    text: "Edit"
                    size_hint_x: None
                    width: 65
                    background_normal: ""
                    background_color: 0.82, 0.91, 0.95, 1
                    color: 0.15, 0.30, 0.40, 1

            Widget:
                size_hint_y: None
                height: 8

            Label:
                id: profile_message
                text: ""
                color: 0.10, 0.45, 0.25, 1
                font_size: "13sp"
                size_hint_y: None
                height: 30

            Button:
                text: "Simpan Perubahan"
                size_hint_y: None
                height: 50
                background_normal: ""
                background_color: 0.25, 0.55, 0.40, 1
                font_size: "15sp"
                on_release: root.save_profile()

            Button:
                text: "Kembali"
                size_hint_y: None
                height: 45
                background_normal: ""
                background_color: 0.35, 0.35, 0.35, 1
                on_release: root.manager.current = "dashboard"

            Widget:
                size_hint_y: None
                height: 20